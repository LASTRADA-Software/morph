# ledger (rung 5) — two books in one database, and every read that must not
# cross between them.
#
# `LedgerModel` is keyed by ledger (book) id, and every action carries one.
# Firefly's own model is one user with several books, so "which book" is an
# argument rather than a connection property -- which means the isolation is
# enforced per call, in the query, and a missing `WHERE ledger_id = ?` would
# be invisible to any test that only ever used one book.
#
# The scenario driver seeds two books precisely so this file can exist: no
# registered action creates a `ledgers` row, so a second book is not something
# a scenario can make for itself.
#
# Re-runnable: the accounts are opened here, in both books, and every
# assertion names a captured id.

client auth model=AuthModel
do Login username=alice
expect ok capture token=$.token
expect ok capture who=$.principal

client books model=LedgerModel
session principal=$who token=$token

# ── One account in each book, with deliberately identical names ────────
# Identical names, so nothing below can pass by matching on a name alone.
do OpenAccount ledgerId=1 name="Isolated wallet" kind="Asset" currency="EUR"
expect ok capture first=$.id

do OpenAccount ledgerId=2 name="Isolated wallet" kind="Asset" currency="EUR"
expect ok capture second=$.id

do OpenAccount ledgerId=1 name="Isolated spend" kind="Expense" currency="EUR"
expect ok capture firstSpend=$.id

do OpenAccount ledgerId=2 name="Isolated spend" kind="Expense" currency="EUR"
expect ok capture secondSpend=$.id

# ── Each book's listing holds its own accounts and not the other's ─────
do GetLedger ledgerId=1
expect ok field accounts ~ "\"id\":$first,"
expect ok field accounts ~ "\"id\":$firstSpend,"
expect ok field accounts !~ "\"id\":$second,"
expect ok field accounts !~ "\"id\":$secondSpend,"

do GetLedger ledgerId=2
expect ok field accounts ~ "\"id\":$second,"
expect ok field accounts ~ "\"id\":$secondSpend,"
expect ok field accounts !~ "\"id\":$first,"
expect ok field accounts !~ "\"id\":$firstSpend,"

# ── A transaction in book one moves book one's balances only ───────────
do StoreTransaction ledgerId=1 description="book one only" date="2026-08-01T00:00:00.000Z" legs=[{"accountId":$first,"amount":{"num":-4000,"den":1,"dp":2}},{"accountId":$firstSpend,"amount":{"num":4000,"den":1,"dp":2}}]
expect ok field accounts ~ "\"id\":$first,\"name\":\"Isolated wallet\",\"kind\":\"Asset\",\"currency\":\"EUR\",\"balance\":.\"num\":-4000"
expect ok field accounts !~ "\"id\":$second,"

do GetLedger ledgerId=2
expect ok field accounts ~ "\"id\":$second,\"name\":\"Isolated wallet\",\"kind\":\"Asset\",\"currency\":\"EUR\",\"balance\":.\"num\":0"

# ── ...and one in book two leaves book one alone ───────────────────────
do StoreTransaction ledgerId=2 description="book two only" date="2026-08-01T00:00:00.000Z" legs=[{"accountId":$second,"amount":{"num":-1500,"den":1,"dp":2}},{"accountId":$secondSpend,"amount":{"num":1500,"den":1,"dp":2}}]
expect ok field accounts ~ "\"id\":$second,\"name\":\"Isolated wallet\",\"kind\":\"Asset\",\"currency\":\"EUR\",\"balance\":.\"num\":-1500"

do GetLedger ledgerId=1
expect ok field accounts ~ "\"id\":$first,\"name\":\"Isolated wallet\",\"kind\":\"Asset\",\"currency\":\"EUR\",\"balance\":.\"num\":-4000"

# ── Budgets are scoped to their own book too ───────────────────────────
client budgets model=BudgetModel
session principal=$who token=$token

do CreateCategory ledgerId=1 name="Isolated category"
expect ok capture category=$

do LinkAccountToCategory accountId=$firstSpend categoryId=$category
expect ok

# The *second* book's account, linked to the *first* book's category. The
# link itself is accepted -- categories and accounts are joined by id, not by
# book -- but the report below must still not count it, because the report
# filters journals by the budget's own ledger.
do LinkAccountToCategory accountId=$secondSpend categoryId=$category
expect ok

do CreateBudget ledgerId=1 name="Isolated budget" categoryId=$category
expect ok capture budget=$

do SetBudgetLimit budgetId=$budget month="2026-08" limit={"num":100000,"den":1,"dp":2} currency="EUR"
expect ok

# 40.00 from book one, and nothing from book two's 15.00, even though both
# accounts are on the category.
do GetBudgetReport budgetId=$budget month="2026-08"
expect ok field spent.num == 4000
expect ok field limit.num == 100000

# ── A report submitted for one book names that book ────────────────────
use books

do SubmitReport ledgerId=1 kind="MonthlyStatement" params="{\"year\":2026,\"month\":8,\"timezoneOffsetMinutes\":0}"
expect ok capture jobOne=$

do SubmitReport ledgerId=2 kind="MonthlyStatement" params="{\"year\":2026,\"month\":8,\"timezoneOffsetMinutes\":0}"
expect ok capture jobTwo=$

do GetReportStatus jobId=$jobOne
expect ok field status == "Pending"

do GetReportStatus jobId=$jobTwo
expect ok field status == "Pending"

# ── A leg may not name another book's account ──────────────────────────
#
# `StoreTransaction ledgerId=1` carrying a leg on a *book two* account is
# refused, and nothing is written. Account ids are a table-wide autoincrement,
# so another book's account id is a well-formed number naming a real row: the
# lookup finds it, and the check that follows asks which book it is in.
#
# Without that check the entry was accepted -- the journal filed under book
# one, book two's balance moved, and every read still scoped, so book one's
# reply did not mention the account it had just moved and book two showed a
# balance change with no journal of its own to explain it. The two books
# disagreed and neither report said so.
#
# The refusal carries its own message, distinct from the not-found one below,
# so "that account is in your other book" and "that id names nothing at all"
# are not the same answer. `UndoTransaction` has always made the equivalent
# check ("journal does not belong to this ledger"); this is the same check at
# the leg's account lookup, and at `ImportLedgerChunk`'s two account lookups.
do StoreTransaction ledgerId=1 description="a leg from the other book" date="2026-08-02T00:00:00.000Z" legs=[{"accountId":$first,"amount":{"num":-100,"den":1,"dp":2}},{"accountId":$secondSpend,"amount":{"num":100,"den":1,"dp":2}}]
expect err message == "StoreTransaction: account does not belong to this ledger"

# Neither book moved: book one is still at the 40.00 it posted for itself...
do GetLedger ledgerId=1
expect ok field accounts ~ "\"id\":$first,\"name\":\"Isolated wallet\",\"kind\":\"Asset\",\"currency\":\"EUR\",\"balance\":.\"num\":-4000"
# ...and book two still at its own 15.00, with no foreign posting on top.
do GetLedger ledgerId=2
expect ok field accounts ~ "\"id\":$secondSpend,\"name\":\"Isolated spend\",\"kind\":\"Expense\",\"currency\":\"EUR\",\"balance\":.\"num\":1500"

# ── An account that exists in no book at all is refused differently ────
# Which is what shows the two refusals are not one: this leg's id names no row
# anywhere, so it never reaches the ownership check.
do StoreTransaction ledgerId=1 description="a leg from nowhere" date="2026-08-03T00:00:00.000Z" legs=[{"accountId":$first,"amount":{"num":-100,"den":1,"dp":2}},{"accountId":999999,"amount":{"num":100,"den":1,"dp":2}}]
expect err message == "StoreTransaction: no such account"

do GetLedger ledgerId=1
expect ok field accounts ~ "\"id\":$first,\"name\":\"Isolated wallet\",\"kind\":\"Asset\",\"currency\":\"EUR\",\"balance\":.\"num\":-4000"

# ── An import chunk may not reach into the other book either ───────────
# Both of `ImportLedgerChunk`'s account lookups are scoped: the chunk-wide
# `counterAccountId`, and the `account_id` column of every CSV row. The opIds
# carry the run's own nonce because an opId is consumed permanently -- see
# import-a-statement-chunk.scenario's own note -- though a refused chunk
# records none.
do ImportLedgerChunk ledgerId=1 counterAccountId=$secondSpend opId="cross-book-counter-$first" csvChunk="date,description,account_id,amount\n2026-08-04T00:00:00.000Z,foreign counter $first,$first,-1.00\n"
expect err message == "ImportLedgerChunk: account does not belong to this ledger"

do ImportLedgerChunk ledgerId=1 counterAccountId=$firstSpend opId="cross-book-row-$first" csvChunk="date,description,account_id,amount\n2026-08-04T00:00:00.000Z,foreign row $first,$second,-1.00\n"
expect err message == "ImportLedgerChunk: account does not belong to this ledger"

# Neither refusal posted anything, in either book.
do GetLedger ledgerId=1
expect ok field accounts ~ "\"id\":$first,\"name\":\"Isolated wallet\",\"kind\":\"Asset\",\"currency\":\"EUR\",\"balance\":.\"num\":-4000"
expect ok field accounts ~ "\"id\":$firstSpend,\"name\":\"Isolated spend\",\"kind\":\"Expense\",\"currency\":\"EUR\",\"balance\":.\"num\":4000"

do GetLedger ledgerId=2
expect ok field accounts ~ "\"id\":$second,\"name\":\"Isolated wallet\",\"kind\":\"Asset\",\"currency\":\"EUR\",\"balance\":.\"num\":-1500"
expect ok field accounts ~ "\"id\":$secondSpend,\"name\":\"Isolated spend\",\"kind\":\"Expense\",\"currency\":\"EUR\",\"balance\":.\"num\":1500"
