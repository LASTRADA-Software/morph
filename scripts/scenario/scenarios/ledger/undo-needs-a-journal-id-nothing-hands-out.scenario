# ledger (rung 5) — the reversal this rung ships, and the id no action returns.
#
# examples/ledger/README.md's "What to implement" step 5: undo is a
# compensating entry, Firefly-style, not a replay -- the journal spec says
# replay is exact only for pure in-memory models, and undoLast() is O(all
# remaining actions), a performance cliff at ledger scale. `UndoTransaction`
# therefore reverses one journal entry, named by `journalId`.
#
# ── Why this file asserts a refusal rather than a reversal ──────────────
# No action in this rung's wire surface ever hands a `journalId` back.
# `StoreTransaction` answers with the whole ledger state -- the posted
# balances, which are a stronger receipt than an id would be, but are not an
# id. `GetLedger` answers with accounts. There is no `GetJournal`, and
# `ImportLedgerChunk` answers with counts. So a WebSocket client can only ever
# call `UndoTransaction` with a number it guessed.
#
# That is a fact about the rung's surface rather than a gap in this corpus,
# and it is what `coverage_allowlist.json` records for `ledger/UndoTransaction`
# (morph#362). This file is that entry's evidence: it drives the action, it
# asserts the one path a client can reach -- the not-found refusal -- and it
# shows the refusal is genuinely a refusal, by proving the ledger it names is
# untouched either side of it.
#
# The surrounding journey is real work, so the refusal is asserted against a
# ledger with something in it to reverse rather than against an empty one.
#
# Re-runnable: the accounts are opened here.

client auth model=AuthModel
do Login username=alice
expect ok capture token=$.token
expect ok capture who=$.principal

client books model=LedgerModel
session principal=$who token=$token

do OpenAccount ledgerId=1 name="Undo cash" kind=0 currency=1
expect ok capture cash=$.id

do OpenAccount ledgerId=1 name="Undo spend" kind=1 currency=1
expect ok capture spend=$.id

# ── Two entries worth reversing, if only they could be named ───────────
do StoreTransaction ledgerId=1 description="first entry" date="2026-08-01T00:00:00.000Z" legs=[{"accountId":$cash,"amount":{"num":-700,"den":1,"dp":2}},{"accountId":$spend,"amount":{"num":700,"den":1,"dp":2}}]
expect ok field accounts ~ "\"id\":$cash,\"name\":\"Undo cash\",\"kind\":0,\"currency\":1,\"balance\":.\"num\":-700"

do StoreTransaction ledgerId=1 description="second entry" date="2026-08-02T00:00:00.000Z" legs=[{"accountId":$cash,"amount":{"num":-300,"den":1,"dp":2}},{"accountId":$spend,"amount":{"num":300,"den":1,"dp":2}}]
expect ok field accounts ~ "\"id\":$cash,\"name\":\"Undo cash\",\"kind\":0,\"currency\":1,\"balance\":.\"num\":-1000"

# ── The reply carries balances, not a journal id ───────────────────────
# Asserted directly: if StoreTransaction ever grows one, this line fails and
# the allowlist entry it supports has to be retired.
expect ok field @body !~ "journalId"

do GetLedger ledgerId=1
expect ok field @body !~ "journalId"
expect ok field accounts ~ "\"id\":$spend,\"name\":\"Undo spend\",\"kind\":1,\"currency\":1,\"balance\":.\"num\":1000"

# ── So the only reachable path is the refusal ──────────────────────────
do UndoTransaction ledgerId=1 journalId=999999
expect err message == "UndoTransaction: no such journal"
expect err message !~ "first entry"
expect err message !~ "second entry"

# ...and the balances are exactly what they were, so nothing was reversed
# halfway.
do GetLedger ledgerId=1
expect ok field accounts ~ "\"id\":$cash,\"name\":\"Undo cash\",\"kind\":0,\"currency\":1,\"balance\":.\"num\":-1000"
expect ok field accounts ~ "\"id\":$spend,\"name\":\"Undo spend\",\"kind\":1,\"currency\":1,\"balance\":.\"num\":1000"

# ── A guessed id in another ledger is refused the same way ─────────────
do UndoTransaction ledgerId=2 journalId=999999
expect err message == "UndoTransaction: no such journal"

# ── The ledger still accepts work afterwards ───────────────────────────
do StoreTransaction ledgerId=1 description="third entry" date="2026-08-03T00:00:00.000Z" legs=[{"accountId":$cash,"amount":{"num":-100,"den":1,"dp":2}},{"accountId":$spend,"amount":{"num":100,"den":1,"dp":2}}]
expect ok field accounts ~ "\"id\":$cash,\"name\":\"Undo cash\",\"kind\":0,\"currency\":1,\"balance\":.\"num\":-1100"
