# bookmarks (rung 2) — a deleted bookmark is gone from the listing, the feed
# and the export, not only from GetBookmark.
#
# examples/bookmarks/README.md's "What to implement" step 1. A delete that
# only removed the row from one read path would pass a GetBookmark check and
# still leak the bookmark through the shared feed or the export file, so this
# drives every read this rung has at the deleted id.
#
# The bookmark is created Shared deliberately: that is the read path with the
# widest audience, and the one where a leak would matter most.
#
# ── Why the url is made unique before the export is checked ───────────────
# ExportBookmarks answers with one HTML document for the whole collection, so
# "the export does not contain this url" is a claim about every row, not about
# one. A fixed url makes that claim false as soon as any other run of this
# file leaves a row behind -- which is exactly what a mutation run does, since
# a mutant that fails aborts before the delete. The bookmark's own id is a
# value no other run has, so an edit stamps it into the url and the title, and
# both export assertions become claims about this run alone.
#
# Re-runnable: the bookmark is created here, and its url carries its id.

client auth model=AuthModel

do Login username=alice
expect ok capture token=$.token
expect ok capture who=$.principal

client store model=BookmarkModel
session principal=$who token=$token

do CreateBookmark url="https://example.com/transient" title="Transient" tags=["temp"] visibility=Shared
expect ok capture doomed=$.id

do GetBookmark id=$doomed
expect ok field title == "Transient"
expect ok field visibility == Shared

# Stamp the id into the url and title, so every assertion below names this run.
do EditBookmark id=$doomed url="https://example.com/transient-$doomed" title="Transient $doomed" tags=["temp"] visibility=Shared
expect ok

do GetBookmark id=$doomed
expect ok field url == "https://example.com/transient-$doomed"
expect ok field visibility == Shared

do ListBookmarks tag=temp
expect ok field bookmarks ~ "\"id\":$doomed,"

client feed model=SharedFeedModel
session principal=$who token=$token

do ListSharedFeed
expect ok field bookmarks ~ "\"id\":$doomed,"

use store

do ExportBookmarks
expect ok field html ~ "https://example.com/transient-$doomed"
expect ok field html ~ ">Transient $doomed</A>"

# ── Delete ─────────────────────────────────────────────────────────────────
do DeleteBookmark id=$doomed
expect ok

do GetBookmark id=$doomed
expect err message == "no such bookmark"

do ListBookmarks tag=temp
expect ok field bookmarks !~ "\"id\":$doomed,"

do ExportBookmarks
expect ok field html !~ "https://example.com/transient-$doomed"
expect ok field html !~ ">Transient $doomed</A>"

use feed

do ListSharedFeed
expect ok field bookmarks !~ "\"id\":$doomed,"

# ── Every mutation at that id is refused too ───────────────────────────────
use store

do EditBookmark id=$doomed url="https://example.com/revenant" title="Revenant" tags=[]
expect err message == "no such bookmark"

do ArchiveBookmark id=$doomed
expect err message == "no such bookmark"

do DeleteBookmark id=$doomed
expect err message == "no such bookmark"
