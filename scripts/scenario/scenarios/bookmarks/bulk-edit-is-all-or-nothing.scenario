# bookmarks (rung 2) — the failing half of the atomic bulk action.
#
# examples/bookmarks/README.md's definition of done: "Bulk edit is atomic
# under injected mid-batch failure." The injected failure available to a wire
# client is an id in the set that the batch cannot legally touch, and there
# are two distinct kinds of it -- an id that does not exist, and an id that
# exists but belongs to somebody else. Both must abort the whole batch.
#
# The assertion that matters is not the refusal. It is the *state of the
# bookmark that was named first and would have been updated first*: a
# non-atomic implementation would have written it before reaching the bad id,
# and would then refuse with exactly the same message.
#
# Re-runnable: every bookmark is created here, and each check reads back a
# captured id.

client auth model=AuthModel

do Login username=alice
expect ok capture aliceToken=$.token
expect ok capture alice=$.principal

do Login username=bob
expect ok capture bobToken=$.token
expect ok capture bob=$.principal

client hers model=BookmarkModel
session principal=$alice token=$aliceToken

do CreateBookmark url="https://example.com/atomic/1" title="Atomic one" tags=["intact"]
expect ok capture one=$.id

do CreateBookmark url="https://example.com/atomic/2" title="Atomic two" tags=["intact"]
expect ok capture two=$.id

client his model=BookmarkModel
session principal=$bob token=$bobToken

do CreateBookmark url="https://example.com/atomic/bob" title="Bob's own" tags=["his"]
expect ok capture bobs=$.id

# ── An id that does not exist, named last ─────────────────────────────────
use hers

do BulkEdit ids=[$one,$two,999999] addTags=["should-not-appear"] archive=Archive
expect err message == "no such bookmark"

# Neither of the two good ids was written. This is the whole test.
do GetBookmark id=$one
expect ok field tags !~ "should-not-appear"
expect ok field archiveState == Active

do GetBookmark id=$two
expect ok field tags !~ "should-not-appear"
expect ok field archiveState == Active

# ── An id that exists but is another principal's ──────────────────────────
# A different refusal, and the same atomicity requirement.
do BulkEdit ids=[$one,$bobs] addTags=["also-should-not-appear"] archive=Archive
expect err message == "bookmark belongs to a different principal"

do GetBookmark id=$one
expect ok field tags !~ "also-should-not-appear"
expect ok field archiveState == Active

# ...and Bob's bookmark was not touched either, in either direction.
use his

do GetBookmark id=$bobs
expect ok field title == "Bob's own"
expect ok field tags !~ "also-should-not-appear"
expect ok field archiveState == Active

# ── The same batch, with the bad id removed, does apply ───────────────────
# Which proves the refusals above were about the bad id and not about the
# batch being rejected for some other reason.
use hers

do BulkEdit ids=[$one,$two] addTags=["applied"] archive=Archive
expect ok field affected.num == 2

do GetBookmark id=$one
expect ok field tags ~ "\"applied\""
expect ok field archiveState == Archived
