# A scenario that is MEANT to fail, kept so the failure report is a thing you
# can look at rather than a claim in a README.
#
#   morph_scenario.py --server ws://127.0.0.1:<port> \
#       scripts/scenario/scenarios/bookmarks/broken-on-purpose.scenario   # exits 1
#
# It signs in, creates a bookmark, then reads it back and asserts a title the
# bookmark was never created with. Everything else here is correct, so the
# report has to name the one step and clause that is not.

client auth model=Bookmarks_AuthModel

do Login username=alice
expect ok capture token=$.token
expect ok capture who=$.principal

client store model=BookmarkModel
session principal=$who token=$token

do CreateBookmark url="https://example.com/broken-on-purpose" title="the title it actually has" tags=[]
expect ok capture mark=$.id

do GetBookmark id=$mark
expect ok field title == "the title the scenario wrongly expects"
