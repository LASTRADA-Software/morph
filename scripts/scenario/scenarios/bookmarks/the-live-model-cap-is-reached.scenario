send register typeId=BookmarkModel
# The last one still succeeds: the cap is a maximum, not a ceiling one
# below it.
expect ok field @modelId != 0

# ── The next one is refused ────────────────────────────────────────────
send register typeId=BookmarkModel
expect err message == "too many models"

# ...and it stays refused: a rejected register consumes no slot, so retrying
# does not eventually succeed.
send register typeId=BookmarkModel
expect err message == "too many models"

# ── The cap is on the server, not on the model type ────────────────────
# A different type is refused too: `maxLiveModels` counts every live model
# this RemoteServer holds, across all callers and all types.
send register typeId=AuthModel
expect err message == "too many models"

send register typeId=TagModel
expect err message == "too many models"

# ── ...and the refusal is a reply, not a disconnection ─────────────────
# The connection is still usable, which matters: a client that hits the cap
# must be able to release instances and carry on rather than reconnect. It is
# still an *unauthenticated* connection though, so what it gets back is this
# rung's ordinary "unauthorized" -- a different refusal from the cap's, which
# is the point: the server is answering it on the merits again.
send instances typeId=BookmarkModel
expect err message == "unauthorized"
expect err message !~ "too many models"

# A second *connection* is refused too -- the cap counts models, not callers --
# but that cannot be asserted here: the `client` directive registers as part of
# opening, so its refusal surfaces as a failed `client` step rather than as a
# reply a scenario can `expect` on. The two type refusals above make the same
# point within one connection, which is as close as the DSL gets.

# ── Release everything by closing the connection ───────────────────────
# This is the step that makes the file re-runnable, and it is also the
# behaviour worth pinning: instances are scoped to the connection that made
# them, so dropping it returns every slot.
close filler

# A fresh connection can register again, which it could not if the slots had
# leaked.
client after

send register typeId=BookmarkModel
expect ok field @modelId != 0

close after
