# kanban (rung 4) — the centerpiece action, and the counts that prove it moved.
#
# examples/kanban/README.md's build order step 2 calls MoveTaskPosition "the
# centerpiece": two users dragging tasks on the same board concurrently is a
# precise test of per-model strand ordering. This file is the single-user half
# of that -- what a move *is* -- and two-clients-converge-on-one-board.scenario
# is the concurrent half.
#
# A move carries a column, a swimlane and a position, so there are three ways
# for it to be wrong and only one for it to be right. The assertion that
# catches all three is the pair of derived `taskCount`s either side of the
# move: a task that landed in the right column at the wrong position, or in
# the right column of the wrong swimlane, still shows up in `tasks` with a
# plausible-looking row.
#
# Re-runnable: the project is created here.

client auth model=AuthModel
do Login username=alice
expect ok capture token=$.token
expect ok capture who=$.principal

client admin model=ProjectAdminModel
session principal=$who token=$token

do CreateProject name="Moves"
expect ok capture project=$.id

client board model=BoardModel
session principal=$who token=$token

do OpenBoard projectId=$project
expect ok

do CreateColumn name="Todo" wipLimit=0
expect ok capture todo=$.columns[0].id

do CreateColumn name="Doing" wipLimit=0
expect ok capture doing=$.columns[1].id

do CreateColumn name="Done" wipLimit=0
expect ok capture done=$.columns[2].id

do CreateSwimlane name="Now"
expect ok capture now=$.swimlanes[0].id

do CreateSwimlane name="Later"
expect ok capture later=$.swimlanes[1].id

do CreateTask columnId=$todo swimlaneId=$now title="Ship it"
expect ok capture task=$.tasks[0].id
expect ok field columns ~ "\"id\":$todo,\"name\":\"Todo\",\"wipLimit\":0,\"taskCount\":1"

# ── Todo -> Doing ─────────────────────────────────────────────────────────
do MoveTaskPosition taskId=$task columnId=$doing swimlaneId=$now position=0
expect ok field tasks ~ "\"id\":$task,\"columnId\":$doing,\"swimlaneId\":$now,\"title\":\"Ship it\",\"position\":0"
expect ok field columns ~ "\"id\":$todo,\"name\":\"Todo\",\"wipLimit\":0,\"taskCount\":0"
expect ok field columns ~ "\"id\":$doing,\"name\":\"Doing\",\"wipLimit\":0,\"taskCount\":1"

# The independent read is the proof, not the move's own reply.
do GetBoardState
expect ok field tasks ~ "\"id\":$task,\"columnId\":$doing,\"swimlaneId\":$now"

# ── ...and across a swimlane, without changing column ────────────────────
do MoveTaskPosition taskId=$task columnId=$doing swimlaneId=$later position=0
expect ok field tasks ~ "\"id\":$task,\"columnId\":$doing,\"swimlaneId\":$later"
expect ok field columns ~ "\"id\":$doing,\"name\":\"Doing\",\"wipLimit\":0,\"taskCount\":1"

# ── ...and on to Done ────────────────────────────────────────────────────
do MoveTaskPosition taskId=$task columnId=$done swimlaneId=$later position=0
expect ok field tasks ~ "\"id\":$task,\"columnId\":$done,\"swimlaneId\":$later"
expect ok field columns ~ "\"id\":$doing,\"name\":\"Doing\",\"wipLimit\":0,\"taskCount\":0"
expect ok field columns ~ "\"id\":$done,\"name\":\"Done\",\"wipLimit\":0,\"taskCount\":1"

# ── Position ordering within one column ──────────────────────────────────
do CreateTask columnId=$done swimlaneId=$later title="Second in Done"
expect ok capture second=$.tasks[1].id

do MoveTaskPosition taskId=$second columnId=$done swimlaneId=$later position=0
expect ok field tasks ~ "\"id\":$second,\"columnId\":$done,\"swimlaneId\":$later,\"title\":\"Second in Done\",\"position\":0"

do GetBoardState
expect ok field columns ~ "\"id\":$done,\"name\":\"Done\",\"wipLimit\":0,\"taskCount\":2"

# ── The refusals ─────────────────────────────────────────────────────────
do MoveTaskPosition taskId=$task columnId=999999 swimlaneId=$later position=0
expect err message == "column does not belong to this project"

do MoveTaskPosition taskId=$task columnId=$done swimlaneId=$later position=-1
expect err message == "action failed validation: BoardModel/MoveTaskPosition"

# Neither refusal moved anything.
do GetBoardState
expect ok field tasks ~ "\"id\":$task,\"columnId\":$done,\"swimlaneId\":$later"
expect ok field columns ~ "\"id\":$done,\"name\":\"Done\",\"wipLimit\":0,\"taskCount\":2"
