# kanban (rung 4) — taking someone off a project, while they are on it.
#
# `RemoveMember` is the other half of `SetMemberRole`, and the case worth
# driving out of process is the one an in-process rig has no way to express:
# the removed person is *already attached*, holding a live board handler, and
# has to lose access on their very next action rather than on a reconnect.
#
# `requireRole` queries `project_has_roles` per action, so a removed row takes
# effect immediately -- the same property promotion relies on, seen from the
# other direction.
#
# Re-runnable: the project is created here.

client auth model=AuthModel

do Login username=alice
expect ok capture aliceToken=$.token
expect ok capture alice=$.principal

do Login username=bob
expect ok capture bobToken=$.token
expect ok capture bob=$.principal

client admin model=ProjectAdminModel
session principal=$alice token=$aliceToken

do CreateProject name="Revocation"
expect ok capture project=$.id

do SetMemberRole projectId=$project principal=bob role=Member
expect ok

client hers model=BoardModel
session principal=$alice token=$aliceToken

do OpenBoard projectId=$project
expect ok

do CreateColumn name="Todo" wipLimit=0
expect ok capture todo=$.columns[0].id

do CreateColumn name="Done" wipLimit=0
expect ok capture done=$.columns[1].id

do CreateSwimlane name="Lane"
expect ok capture lane=$.swimlanes[0].id

# ── He is on the project and working ───────────────────────────────────
client his model=BoardModel
session principal=$bob token=$bobToken

do OpenBoard projectId=$project
expect ok

do CreateTask columnId=$todo swimlaneId=$lane title="His work"
expect ok capture task=$.tasks[0].id

do AddComment taskId=$task body="Nearly done"
expect ok field comments ~ "\"principal\":\"bob\""

client hisAdmin model=ProjectAdminModel
session principal=$bob token=$bobToken

do GetMyProjects
expect ok field projects ~ "\"id\":$project,\"name\":\"Revocation\",\"myRole\":\"Member\""

# ── Removed, on the handler he is still holding ────────────────────────
use admin

do RemoveMember projectId=$project principal=bob
expect ok

do GetProjectRoles projectId=$project
expect ok field roles !~ "bob"
expect ok field roles ~ "\"principal\":\"alice\",\"role\":\"Manager\""

# ── His next action fails, without a reconnect ─────────────────────────
use his

do MoveTaskPosition taskId=$task columnId=$done swimlaneId=$lane position=0
expect err message == "caller's role does not permit this action"

do GetBoardState
expect err message == "caller's role does not permit this action"

do AddComment taskId=$task body="One more thing"
expect err message == "caller's role does not permit this action"

# Reopening does not help him either.
do OpenBoard projectId=$project
expect err message == "caller's role does not permit this action"

use hisAdmin

do GetMyProjects
expect ok field projects !~ "\"id\":$project,"

do GetProjectRoles projectId=$project
expect err message == "caller's role does not permit this action"

# ── The work he did before the removal stays ───────────────────────────
# Removing a member is not removing their contributions, which is the
# distinction a naive cascade delete would lose.
use hers

do GetBoardState
expect ok field tasks ~ "\"id\":$task,\"columnId\":$todo,\"swimlaneId\":$lane,\"title\":\"His work\""
expect ok field comments ~ "\"principal\":\"bob\",\"body\":\"Nearly done\""

do GetActivity
expect ok field events ~ "\"actionType\":\"CreateTask\",\"principal\":\"bob\""

# ── Removing somebody who is not a member is a no-op, not an error ─────
# Which is the right shape for a remove that a retry may repeat, and the same
# idempotence the delete actions on the other rungs have.
use admin

do RemoveMember projectId=$project principal=carol
expect ok field @body == "{}"

do RemoveMember projectId=$project principal=bob
expect ok field @body == "{}"

do GetProjectRoles projectId=$project
expect ok field roles !~ "bob"
expect ok field roles !~ "carol"
expect ok field roles ~ "\"principal\":\"alice\",\"role\":\"Manager\""

# ...and a principal the validator will not accept is refused before any of
# that happens.
do RemoveMember projectId=$project principal="not a principal!"
expect err message == "action failed validation: ProjectAdminModel/RemoveMember"

# ── Adding him back restores him, on the same held handler ─────────────
do SetMemberRole projectId=$project principal=bob role=Member
expect ok

use his

do GetBoardState
expect ok field tasks ~ "\"id\":$task,"

do MoveTaskPosition taskId=$task columnId=$done swimlaneId=$lane position=0
expect ok field tasks ~ "\"id\":$task,\"columnId\":$done,\"swimlaneId\":$lane"
