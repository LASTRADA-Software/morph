# kanban (rung 4) — the read-only role, and every door it may not open.
#
# examples/kanban/README.md's build order step 4: per-project RBAC
# (viewer/member/manager), enforced **inside** `BoardModel::execute()` by a
# `requireRole(Role)` helper querying `project_has_roles` directly -- not by a
# change to `IAuthorizer`. The README gives the reason at length: shared
# instances have no single owner for `authorizeInstance` to compare against,
# and `authorizeInstance` never runs on the `LocalBackend` path at all, so an
# authorizer-only check would silently not exist for local callers.
#
# `requireRole` needs a *trustworthy* principal to key its lookup on, which is
# why `KanbanAuthorizer` is SigningAuthorizer-derived: an authorizer that never
# authenticates has its caller's principal cleared to empty before dispatch,
# and every role check would then either always deny or diverge between Local
# and Socket modes. Two sockets with two real signed identities is the shape
# that actually exercises it.
#
# This file drives *every* BoardModel action a viewer can reach and asserts
# the same refusal for each, rather than checking one and inferring the rest.
#
# Re-runnable: the project is created here.

client auth model=AuthModel

do Login username=alice
expect ok capture aliceToken=$.token
expect ok capture alice=$.principal

do Login username=bob
expect ok capture bobToken=$.token
expect ok capture bob=$.principal

client admin model=ProjectAdminModel
session principal=$alice token=$aliceToken

do CreateProject name="Read only"
expect ok capture project=$.id

client hers model=BoardModel
session principal=$alice token=$aliceToken

do OpenBoard projectId=$project
expect ok

do CreateColumn name="Todo" wipLimit=0
expect ok capture todo=$.columns[0].id

do CreateColumn name="Done" wipLimit=0
expect ok capture done=$.columns[1].id

do CreateSwimlane name="Lane"
expect ok capture lane=$.swimlanes[0].id

do CreateTask columnId=$todo swimlaneId=$lane title="Not yours to move"
expect ok capture task=$.tasks[0].id

# ── A stranger cannot even open the board ──────────────────────────────
client his model=BoardModel
session principal=$bob token=$bobToken

do OpenBoard projectId=$project
expect err message == "caller's role does not permit this action"

# ── ...and a Viewer can ────────────────────────────────────────────────
use admin

do SetMemberRole projectId=$project principal=bob role=Viewer
expect ok

do GetProjectRoles projectId=$project
expect ok field roles ~ "\"principal\":\"bob\",\"role\":\"Viewer\""

use his

do OpenBoard projectId=$project
expect ok field projectId == $project
expect ok field tasks ~ "\"id\":$task,"

do GetBoardState
expect ok field tasks ~ "\"id\":$task,\"columnId\":$todo,\"swimlaneId\":$lane"

do GetEventsSince lastEventId=0
expect ok field events ~ "\"kind\":\"task\""

do GetActivity
expect ok field events ~ "\"actionType\":\"CreateTask\",\"principal\":\"alice\""

do GetRules projectId=$project
expect ok field rules == []

do GetAttachments taskId=$task
expect ok field attachments == []

# ── ...and may write nothing at all ────────────────────────────────────
do CreateColumn name="Bob's column" wipLimit=0
expect err message == "caller's role does not permit this action"

do CreateSwimlane name="Bob's lane"
expect err message == "caller's role does not permit this action"

do CreateTask columnId=$todo swimlaneId=$lane title="Bob's task"
expect err message == "caller's role does not permit this action"

do MoveTaskPosition taskId=$task columnId=$done swimlaneId=$lane position=0
expect err message == "caller's role does not permit this action"

do AddComment taskId=$task body="Bob's comment"
expect err message == "caller's role does not permit this action"

do ApplyTagMutation taskId=$task mutationType=AddTag tag=bobs
expect err message == "caller's role does not permit this action"

do AddAttachment taskId=$task filename="bob.txt" contentType="text/plain" sizeBytes=1 storageKey="k"
expect err message == "caller's role does not permit this action"

do CreateRule projectId=$project triggerColumnId=$done mutationType=AddTag mutationValue=bobs
expect err message == "caller's role does not permit this action"

# ── Nor administer ─────────────────────────────────────────────────────
client hisAdmin model=ProjectAdminModel
session principal=$bob token=$bobToken

do SetMemberRole projectId=$project principal=carol role=Member
expect err message == "caller's role does not permit this action"

do RemoveMember projectId=$project principal=alice
expect err message == "caller's role does not permit this action"

# ── ...but the project is his to list ──────────────────────────────────
do GetMyProjects
expect ok field projects ~ "\"id\":$project,\"name\":\"Read only\",\"myRole\":\"Viewer\""

do GetProjectRoles projectId=$project
expect ok field roles ~ "\"principal\":\"alice\",\"role\":\"Manager\""

# ── Not one of the refusals changed the board ──────────────────────────
use hers

do GetBoardState
expect ok field tasks ~ "\"id\":$task,\"columnId\":$todo,\"swimlaneId\":$lane,\"title\":\"Not yours to move\",\"position\":0,\"tags\":\\[\\]"
expect ok field columns ~ "\"id\":$todo,\"name\":\"Todo\",\"wipLimit\":0,\"taskCount\":1"
expect ok field columns !~ "Bob's column"
expect ok field swimlanes !~ "Bob's lane"
expect ok field comments == []

do GetAttachments taskId=$task
expect ok field attachments == []
