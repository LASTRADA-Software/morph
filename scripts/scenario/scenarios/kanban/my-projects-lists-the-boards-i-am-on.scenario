# kanban (rung 4) — the per-caller project list, and what each person's copy
# of it says.
#
# `GetMyProjects` takes no arguments at all: its whole answer is derived from
# the verified principal. That makes it the narrowest test there is of whether
# the identity `RemoteServer` stamps is the one the model reads -- a model that
# read the client-asserted principal instead would give every caller the same
# list, and every other RBAC assertion in this directory would still pass.
#
# `myRole` is per caller too, so the *same* project appears in two people's
# lists with two different roles.
#
# Re-runnable: all three projects are created here, and every assertion is
# anchored to a captured id.

client auth model=AuthModel

do Login username=alice
expect ok capture aliceToken=$.token
expect ok capture alice=$.principal

do Login username=bob
expect ok capture bobToken=$.token
expect ok capture bob=$.principal

client herAdmin model=ProjectAdminModel
session principal=$alice token=$aliceToken

client hisAdmin model=ProjectAdminModel
session principal=$bob token=$bobToken

# ── Her project, his project, and one they share ───────────────────────
do CreateProject name="His alone"
expect ok capture hisOwn=$.id

use herAdmin

do CreateProject name="Hers alone"
expect ok capture herOwn=$.id

do CreateProject name="Shared"
expect ok capture shared=$.id

do SetMemberRole projectId=$shared principal=bob role=Viewer
expect ok

# ── Her list ───────────────────────────────────────────────────────────
do GetMyProjects
expect ok field projects ~ "\"id\":$herOwn,\"name\":\"Hers alone\",\"myRole\":\"Manager\""
expect ok field projects ~ "\"id\":$shared,\"name\":\"Shared\",\"myRole\":\"Manager\""
expect ok field projects !~ "\"id\":$hisOwn,"
expect ok field projects !~ "His alone"

# ── His ────────────────────────────────────────────────────────────────
use hisAdmin

do GetMyProjects
expect ok field projects ~ "\"id\":$hisOwn,\"name\":\"His alone\",\"myRole\":\"Manager\""
# The same project, with his role rather than hers.
expect ok field projects ~ "\"id\":$shared,\"name\":\"Shared\",\"myRole\":\"Viewer\""
expect ok field projects !~ "\"id\":$herOwn,"
expect ok field projects !~ "Hers alone"

# ── A promotion changes his copy and not hers ──────────────────────────
use herAdmin

do SetMemberRole projectId=$shared principal=bob role=Manager
expect ok

use hisAdmin

do GetMyProjects
expect ok field projects ~ "\"id\":$shared,\"name\":\"Shared\",\"myRole\":\"Manager\""

use herAdmin

do GetMyProjects
expect ok field projects ~ "\"id\":$shared,\"name\":\"Shared\",\"myRole\":\"Manager\""

# ── Neither may read the other's private project's roles ───────────────
do GetProjectRoles projectId=$hisOwn
expect err message == "caller's role does not permit this action"

use hisAdmin

do GetProjectRoles projectId=$herOwn
expect err message == "caller's role does not permit this action"

# ...but the shared one is both of theirs to read.
do GetProjectRoles projectId=$shared
expect ok field roles ~ "\"principal\":\"alice\",\"role\":\"Manager\""
expect ok field roles ~ "\"principal\":\"bob\",\"role\":\"Manager\""

# ── Leaving takes it off his list, and not off hers ────────────────────
do RemoveMember projectId=$shared principal=bob
expect ok

do GetMyProjects
expect ok field projects !~ "\"id\":$shared,"
expect ok field projects ~ "\"id\":$hisOwn,"

use herAdmin

do GetMyProjects
expect ok field projects ~ "\"id\":$shared,\"name\":\"Shared\",\"myRole\":\"Manager\""
