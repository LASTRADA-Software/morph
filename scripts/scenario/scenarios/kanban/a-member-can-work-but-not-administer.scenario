# kanban (rung 4) — the middle role, and where its authority stops.
#
# examples/kanban/README.md's build order step 4: viewer/member/manager.
# Member is the working role -- it may do the board work a viewer may not --
# and this file is about the line above it rather than the one below: a member
# may not create rules, and may not change anybody's role, including their own.
#
# Kanboard enforces permissions per procedure, and this rung mirrors that per
# action, so "what a Member may do" is a list rather than a rule. It is
# enumerated here, both halves, because the only way to know where the line is
# is to drive every action on both sides of it.
#
# Re-runnable: the project is created here.

client auth model=AuthModel

do Login username=alice
expect ok capture aliceToken=$.token
expect ok capture alice=$.principal

do Login username=bob
expect ok capture bobToken=$.token
expect ok capture bob=$.principal

client admin model=ProjectAdminModel
session principal=$alice token=$aliceToken

do CreateProject name="Working"
expect ok capture project=$.id

do SetMemberRole projectId=$project principal=bob role=Member
expect ok

client hers model=BoardModel
session principal=$alice token=$aliceToken

do OpenBoard projectId=$project
expect ok

do CreateColumn name="Todo" wipLimit=0
expect ok capture todo=$.columns[0].id

do CreateColumn name="Done" wipLimit=0
expect ok capture done=$.columns[1].id

do CreateSwimlane name="Lane"
expect ok capture lane=$.swimlanes[0].id

# ── Everything a Member may do ─────────────────────────────────────────
client his model=BoardModel
session principal=$bob token=$bobToken

do OpenBoard projectId=$project
expect ok

do CreateColumn name="His column" wipLimit=2
expect ok capture hisColumn=$.columns[2].id

do CreateSwimlane name="His lane"
expect ok capture hisLane=$.swimlanes[1].id

do CreateTask columnId=$todo swimlaneId=$lane title="His task"
expect ok capture task=$.tasks[0].id

do MoveTaskPosition taskId=$task columnId=$done swimlaneId=$lane position=0
expect ok field tasks ~ "\"id\":$task,\"columnId\":$done,\"swimlaneId\":$lane"

do AddComment taskId=$task body="Working on it"
expect ok field comments ~ "\"principal\":\"bob\",\"body\":\"Working on it\""

do ApplyTagMutation taskId=$task mutationType=AddTag tag=inflight
expect ok

do AddAttachment taskId=$task filename="wip.txt" contentType="text/plain" sizeBytes=8 storageKey="k/wip"
expect ok

do GetAttachments taskId=$task
expect ok field attachments ~ "\"uploadedBy\":\"bob\""

do GetBoardState
expect ok field tasks ~ "\"id\":$task,\"columnId\":$done,\"swimlaneId\":$lane,\"title\":\"His task\",\"position\":0,\"tags\":\\[\"inflight\"\\]"
expect ok field columns ~ "\"id\":$hisColumn,\"name\":\"His column\",\"wipLimit\":2,\"taskCount\":0"

# ── ...and where it stops ──────────────────────────────────────────────
# Rules are the automation surface, so they are Manager-only even though
# everything they mutate is Member-writable by hand.
do CreateRule projectId=$project triggerColumnId=$done mutationType=AddTag mutationValue=shipped
expect err message == "caller's role does not permit this action"

# Reading them is not.
do GetRules projectId=$project
expect ok field rules == []

client hisAdmin model=ProjectAdminModel
session principal=$bob token=$bobToken

do SetMemberRole projectId=$project principal=carol role=Member
expect err message == "caller's role does not permit this action"

# Not even to promote himself.
do SetMemberRole projectId=$project principal=bob role=Manager
expect err message == "caller's role does not permit this action"

do RemoveMember projectId=$project principal=alice
expect err message == "caller's role does not permit this action"

# ── ...and the refusals changed nothing about who is who ───────────────
do GetProjectRoles projectId=$project
expect ok field roles ~ "\"principal\":\"bob\",\"role\":\"Member\""
expect ok field roles ~ "\"principal\":\"alice\",\"role\":\"Manager\""
expect ok field roles !~ "carol"

do GetMyProjects
expect ok field projects ~ "\"id\":$project,\"name\":\"Working\",\"myRole\":\"Member\""

# ── A Manager creates the rule the Member could not ────────────────────
use hers

do CreateRule projectId=$project triggerColumnId=$done mutationType=AddTag mutationValue=shipped
expect ok capture rule=$.ruleId

# ...and the Member's work then triggers it, which is the point of the split:
# members do the work, managers decide what the work sets off.
use his

do MoveTaskPosition taskId=$task columnId=$todo swimlaneId=$lane position=0
expect ok

do MoveTaskPosition taskId=$task columnId=$done swimlaneId=$lane position=0
expect ok field tasks ~ "\"shipped\""

do DeleteRule ruleId=$rule
expect err message == "caller's role does not permit this action"

do GetRules projectId=$project
expect ok field rules ~ "\"id\":$rule,"
