{
  "catalog": {
    "models": [
      {"type": "Lims_SampleModel", "keyed": true},
      {"type": "Lims_CatalogModel", "stateless": true},
      {"type": "Lims_ClientModel"},
      {"type": "Auth_SessionModel", "stateless": true}
    ],
    "actions": [
      {"id": "Lims_ListResults", "model": "Lims_SampleModel", "request": "{sampleId: int}",
       "reply": "list<{id: int, mass: decimal?, concentration: quantity?, note: string?}>",
       "calculated": ["concentration"]},
      {"id": "Lims_Capture", "model": "Lims_SampleModel", "request": "{id: int, mass: decimal}",
       "reply": "{id: int, mass: decimal, concentration: quantity?}"},
      {"id": "Lims_ListClients", "model": "Lims_ClientModel", "request": "{}", "reply": "list<{id: int, name: string}>"},
      {"id": "Auth_SignIn", "model": "Auth_SessionModel", "request": "{user: string, password: string}",
       "reply": "{token: string}", "credential": true}
    ],
    "components": ["BundleChart"]
  },
  "documents": [
    {"name": "a screen using every declaration validates", "refusals": [], "document": {
      "vocab": "ui/1", "id": "lims.results", "params": {"sampleId": "int"},
      "title": {"t": "lims.results.title", "fallback": "Results"}, "dirty": {"ref": "unsaved"},
      "onClose": [{"if": [{"ref": "unsaved"}, [{"open": "confirm"}, {"cancelClose": true}], []]}],
      "models": {"sample": {"type": "Lims_SampleModel", "instance": {"ref": "sampleId"}},
                 "clients": {"type": "Lims_ClientModel", "instance": "private"},
                 "session": {"type": "Auth_SessionModel"}},
      "state": {"unsaved": {"init": false}, "filter": {"type": "string?", "init": null}, "picked": {"init": 0}},
      "let": {"heavy": {"filter": {"query": "results"}, "as": "r", "where": {"fn": "gt", "args": [{"ref": "r.mass"}, 10]}},
              "heavyCount": {"fn": "count", "args": [{"ref": "heavy"}]}},
      "queries": {"results": {"model": "sample", "action": "Lims_ListResults",
                              "body": {"obj": {"sampleId": {"ref": "sampleId"}}}, "refreshOn": ["Lims_Capture"]},
                  "clientList": {"model": "clients", "action": "Lims_ListClients"}},
      "mutations": {"capture": {"model": "sample", "action": "Lims_Capture", "invalidates": ["results"],
                                "patch": {"query": "results", "key": {"ref": "result.id"}, "with": {"ref": "result"}},
                                "optimistic": {"query": "results", "key": {"ref": "body.id"},
                                               "with": {"obj": {"id": {"ref": "body.id"}, "mass": {"ref": "body.mass"}}}},
                                "onSuccess": [{"set": "unsaved", "value": false}]},
                    "signIn": {"model": "session", "action": "Auth_SignIn"}},
      "watch": [{"on": {"ref": "filter"}, "source": "user", "do": [{"set": "unsaved", "value": true}]}],
      "checks": [{"id": "some", "assert": {"fn": "gt", "args": [{"ref": "heavyCount"}, 0]}, "targets": ["filterInput"]}],
      "customize": {"density": {"kind": "choice", "options": ["comfortable", "compact"], "default": "compact"},
                    "cols": {"kind": "columns", "of": "resultsTable"}},
      "components": {"Chart": {"qml": "sha256:4b1e", "props": {"series": "json"},
                               "fallback": {"kind": "text", "text": {"fn": "concat", "args": ["n=", {"ref": "props.count"}]}}}},
      "prefetch": ["results"],
      "view": {"kind": "column", "children": [
        {"kind": "textInput", "id": "filterInput", "value": {"ref": "filter"},
         "onChange": [{"set": "filter", "value": {"ref": "event"}}],
         "visible": {"fn": "eq", "args": [{"pref": "density"}, "compact"]}},
        {"kind": "table", "id": "resultsTable", "rows": {"query": "results"}, "key": {"row": "id"},
         "scope": {"state": {"draft": {"init": {"row": "mass"}}}},
         "columns": [{"label": "Mass", "cell": {"kind": "text", "text": {"fn": "number", "args": [{"row": "mass"}]}}},
                     {"label": "Calc", "cell": {"kind": "text", "text": {"fn": "quantity", "args": [{"row": "concentration"}]},
                                                "stale": {"pending": "capture"}}}],
         "onActivate": [{"seq": [{"run": "capture", "as": "c"}, {"notify": {"fn": "format", "args": ["Saved {0}", {"ref": "c.id"}]}},
                                 {"refetch": "results"}]}]},
        {"kind": "boundary", "loading": [{"kind": "busy"}],
         "error": [{"kind": "button", "label": {"ref": "boundary.error"}, "onClick": {"retry": true}}],
         "children": [{"kind": "custom", "name": "Chart", "props": {"series": {"query": "results"}}},
                      {"kind": "custom", "name": "BundleChart"}]},
        {"kind": "button", "label": "Focus", "enabled": {"can": "capture"}, "onClick": [{"focus": "filterInput"}, {"resetPrefs": "density"}]},
        {"kind": "dialog", "id": "confirm", "children": [{"kind": "button", "label": "Close", "onClick": {"close": "self"}}]}
      ]}}},

    {"name": "a row scope's state shadows the screen's of the same name", "refusals": [], "document": {
      "vocab": "ui/1", "id": "shadow",
      "models": {"sample": {"type": "Lims_SampleModel", "instance": "shared"}},
      "state": {"x": {"init": "outer"}},
      "queries": {"results": {"model": "sample", "action": "Lims_ListResults", "body": {"obj": {"sampleId": 1}}}},
      "view": {"kind": "forEach", "rows": {"query": "results"}, "key": {"row": "id"},
               "scope": {"state": {"x": {"init": 1}}},
               "children": [{"kind": "text", "text": {"fn": "number", "args": [{"fn": "add", "args": [{"ref": "x"}, 1]}]}}]}}},

    {"name": "a vocabulary the client does not speak", "document": {"vocab": "ui/2", "id": "v", "view": {"kind": "spacer"}},
     "refusals": [{"path": "/vocab", "reason": "the document is written in `ui/2`; this client speaks ui/1"}]},

    {"name": "a document without a vocabulary or an id",
     "document": {"view": {"kind": "spacer"}},
     "refusals": [{"path": "", "reason": "a screen document names its `vocab`"},
                  {"path": "", "reason": "a screen document names its `id`"}]},

    {"name": "a reference that does not resolve",
     "document": {"vocab": "ui/1", "id": "r", "view": {"kind": "text", "text": {"ref": "missing.field"}}},
     "refusals": [{"path": "/view/text", "reason": "`missing` is not declared in scope"}]},

    {"name": "a name declared twice in one scope",
     "document": {"vocab": "ui/1", "id": "d", "state": {"a": {"init": 1}}, "let": {"a": 2}, "view": {"kind": "spacer"}},
     "refusals": [{"path": "/let/a", "reason": "`a` is declared twice in this scope"}]},

    {"name": "a bool property given a string",
     "document": {"vocab": "ui/1", "id": "b", "view": {"kind": "text", "visible": "yes"}},
     "refusals": [{"path": "/view/visible", "reason": "`visible` is a bool, not a string"}]},

    {"name": "a field the row type does not have",
     "document": {"vocab": "ui/1", "id": "f", "models": {"sample": {"type": "Lims_SampleModel", "instance": "shared"}},
                  "queries": {"results": {"model": "sample", "action": "Lims_ListResults", "body": {"obj": {"sampleId": 1}}}},
                  "view": {"kind": "table", "rows": {"query": "results"}, "key": {"row": "id"},
                           "columns": [{"label": "M", "cell": {"kind": "text", "text": {"row": "massx"}}}]}},
     "refusals": [{"path": "/view/columns/0/cell/text", "reason": "`row` has no field `massx`"}]},

    {"name": "arithmetic on a string",
     "document": {"vocab": "ui/1", "id": "a", "state": {"s": {"init": "x"}},
                  "view": {"kind": "text", "text": {"fn": "number", "args": [{"fn": "add", "args": [{"ref": "s"}, 1]}]}}},
     "refusals": [{"path": "/view/text/args/0/args/0", "reason": "`add` takes numbers or quantities, not a string"}]},

    {"name": "an init that is not of the declared type",
     "document": {"vocab": "ui/1", "id": "i", "state": {"n": {"type": "int", "init": "x"}}, "view": {"kind": "spacer"}},
     "refusals": [{"path": "/state/n/init", "reason": "`init` is a string, not an int"}]},

    {"name": "a cycle among let entries",
     "document": {"vocab": "ui/1", "id": "l", "let": {"a": {"ref": "b"}, "b": {"fn": "add", "args": [{"ref": "a"}, 1]}},
                  "view": {"kind": "spacer"}},
     "refusals": [{"path": "/let/a", "reason": "the `let` entries form a cycle: a → b → a"}]},

    {"name": "a cycle among watches",
     "document": {"vocab": "ui/1", "id": "w", "state": {"x": {"init": 0}, "y": {"init": 0}},
                  "watch": [{"on": {"ref": "x"}, "do": [{"set": "y", "value": 1}]},
                            {"on": {"ref": "y"}, "do": [{"set": "x", "value": 2}]}],
                  "view": {"kind": "spacer"}},
     "refusals": [{"path": "/watch/0", "reason": "the watches form a cycle: /watch/0 → /watch/1 → /watch/0"}]},

    {"name": "an expression over the size bound", "document": {"vocab": "ui/1", "id": "s", "view": {"kind": "text",
      "text": {"fn": "concat", "args": ["a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a","a"]}}},
     "refusals": [{"path": "/view/text/args/255", "reason": "the expression holds more than 256 nodes"}]},

    {"name": "a function outside expr/1",
     "document": {"vocab": "ui/1", "id": "u", "view": {"kind": "text", "text": {"fn": "eval", "args": ["1"]}}},
     "refusals": [{"path": "/view/text/fn", "reason": "`eval` is not a function of expr/1"}]},

    {"name": "a node kind outside ui/1",
     "document": {"vocab": "ui/1", "id": "k", "view": {"kind": "carousel"}},
     "refusals": [{"path": "/view/kind", "reason": "`carousel` is not a node kind of ui/1"}]},

    {"name": "a must-understand key the client does not know",
     "document": {"vocab": "ui/1", "id": "m", "!requires": "sync/1", "view": {"kind": "spacer"}},
     "refusals": [{"path": "/!requires", "reason": "`!requires` must be understood, and a screen document has no such key"}]},

    {"name": "the catalog's model types and actions",
     "document": {"vocab": "ui/1", "id": "c",
                  "models": {"sample": {"type": "Lims_SampleModel", "instance": "shared"}, "ghost": {"type": "Nope_Model"},
                             "clients": {"type": "Lims_ClientModel", "instance": {"ref": "sampleId"}}},
                  "params": {"sampleId": "int"},
                  "queries": {"a": {"model": "sample", "action": "Lims_Unknown"},
                              "b": {"model": "sample", "action": "Lims_ListClients"},
                              "c": {"model": "nobody", "action": "Lims_ListResults"},
                              "d": {"model": "sample", "action": "Lims_ListResults", "refreshOn": ["Lims_ListClients"]}},
                  "view": {"kind": "spacer"}},
     "refusals": [{"path": "/models/ghost/type", "reason": "`Nope_Model` is not a model type of the catalog"},
                  {"path": "/models/clients/instance", "reason": "`Lims_ClientModel` is not keyed, so `instance` cannot select one"},
                  {"path": "/queries/a", "reason": "`Lims_Unknown` is not an action of the catalog"},
                  {"path": "/queries/b", "reason": "`Lims_ListClients` is not an action of `Lims_SampleModel`"},
                  {"path": "/queries/c/model", "reason": "`nobody` is not a model alias in scope"},
                  {"path": "/queries/d/refreshOn", "reason": "`Lims_ListClients` is not an action of `Lims_SampleModel`"}]},

    {"name": "a row scope's model alias without an instance",
     "document": {"vocab": "ui/1", "id": "rs", "state": {"rows": {"init": {"lit": [{"id": 1}]}}},
                  "view": {"kind": "forEach", "rows": {"ref": "rows"}, "key": {"row": "id"},
                           "scope": {"models": {"m": {"type": "Lims_ClientModel"}}}, "children": []}},
     "refusals": [{"path": "/view/scope/models/m", "reason": "a model alias in a row scope names its `instance`"}]},

    {"name": "an optimistic write to a calculated field",
     "document": {"vocab": "ui/1", "id": "o", "models": {"sample": {"type": "Lims_SampleModel", "instance": "shared"}},
                  "queries": {"results": {"model": "sample", "action": "Lims_ListResults", "body": {"obj": {"sampleId": 1}}}},
                  "mutations": {"capture": {"model": "sample", "action": "Lims_Capture",
                                            "optimistic": {"query": "results", "key": {"ref": "body.id"},
                                                           "with": {"obj": {"id": {"ref": "body.id"}, "concentration": null}}}}},
                  "view": {"kind": "spacer"}},
     "refusals": [{"path": "/mutations/capture/optimistic/with/obj/concentration",
                   "reason": "`concentration` is calculated by the server and cannot be written optimistically"}]},

    {"name": "a credential mutation queued offline",
     "document": {"vocab": "ui/1", "id": "q", "models": {"session": {"type": "Auth_SessionModel"}},
                  "mutations": {"signIn": {"model": "session", "action": "Auth_SignIn", "offline": "queue"}},
                  "view": {"kind": "spacer"}},
     "refusals": [{"path": "/mutations/signIn/offline", "reason": "a mutation that carries a credential is never queued offline"}]},

    {"name": "commands outside the place they are valid in",
     "document": {"vocab": "ui/1", "id": "p", "onMount": [{"cancelClose": true}],
                  "view": {"kind": "button", "label": {"ref": "event"}, "onClick": [{"retry": true}]}},
     "refusals": [{"path": "/onMount/0", "reason": "`cancelClose` is valid only in `onClose`"},
                  {"path": "/view/label", "reason": "{\"ref\": \"event\"} is valid only in a command list"},
                  {"path": "/view/onClick/0", "reason": "`retry` is valid only inside a boundary's `error`"}]},

    {"name": "commands naming what the scope does not declare",
     "document": {"vocab": "ui/1", "id": "n", "state": {"s": {"init": 1}},
                  "view": {"kind": "column", "children": [
                    {"kind": "text", "id": "label"},
                    {"kind": "button", "onClick": [{"refetch": "nothing"}, {"run": "nothing"}, {"open": "label"},
                                                   {"focus": "ghost"}, {"reset": "label"}, {"set": "nowhere", "value": 1},
                                                   {"resetPrefs": "nothing"}]}]}},
     "refusals": [{"path": "/view/children/1/onClick/0", "reason": "`nothing` is not a query in scope"},
                  {"path": "/view/children/1/onClick/1", "reason": "`nothing` is not a mutation in scope"},
                  {"path": "/view/children/1/onClick/2", "reason": "`label` is not a dialog or a drawer in scope"},
                  {"path": "/view/children/1/onClick/3", "reason": "`ghost` is not an element in scope"},
                  {"path": "/view/children/1/onClick/4", "reason": "`label` is not state in scope"},
                  {"path": "/view/children/1/onClick/5", "reason": "`nowhere` is not state or an element in scope"},
                  {"path": "/view/children/1/onClick/6", "reason": "`nothing` is not a customization point of the screen"}]},

    {"name": "forms that read what is not there",
     "document": {"vocab": "ui/1", "id": "x",
                  "view": {"kind": "column", "children": [
                    {"kind": "text", "text": {"row": "id"}},
                    {"kind": "text", "text": {"env": "colour"}},
                    {"kind": "text", "text": {"query": "nothing"}},
                    {"kind": "text", "visible": {"pending": "nothing"}},
                    {"kind": "text", "text": {"pref": "nothing"}},
                    {"kind": "custom", "name": "Ghost"},
                    {"kind": "customize", "point": "nothing"}]}},
     "refusals": [{"path": "/view/children/0/text", "reason": "`row` is valid only inside a row of a `forEach` or a `table`"},
                  {"path": "/view/children/1/text", "reason": "`colour` is not an environment attribute"},
                  {"path": "/view/children/2/text", "reason": "`nothing` is not a query in scope"},
                  {"path": "/view/children/3/visible", "reason": "`nothing` is not a query or a mutation in scope"},
                  {"path": "/view/children/4/text", "reason": "`nothing` is not a customization point of the screen"},
                  {"path": "/view/children/5", "reason": "`Ghost` is not a component of the bundle"},
                  {"path": "/view/children/6", "reason": "a `customize` node names a customization point of the screen"}]}
  ]
}
