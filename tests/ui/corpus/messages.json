{
  "plurals": [
    { "locale": "en", "cases": [[0, "other"], [1, "one"], [2, "other"], [{"num": 1, "den": 1, "dp": 1}, "other"]] },
    { "locale": "EN-us", "cases": [[1, "one"], [5, "other"]] },
    { "locale": "de", "cases": [[1, "one"], [0, "other"]] },
    { "locale": "nl", "cases": [[1, "one"], [2, "other"]] },
    { "locale": "sv", "cases": [[1, "one"], [2, "other"]] },
    { "locale": "it", "cases": [[1, "one"], [0, "other"], [{"num": 1, "den": 1, "dp": 1}, "other"], [2, "other"], [1000000, "many"], [{"num": 1000000, "den": 1, "dp": 1}, "other"]] },
    { "locale": "es", "cases": [[1, "one"], [{"num": 1, "den": 1, "dp": 2}, "one"], [2, "other"], [1000000, "many"], [{"num": 3, "den": 2, "dp": 1}, "other"]] },
    { "locale": "fr", "cases": [[0, "one"], [1, "one"], [{"num": 3, "den": 2, "dp": 1}, "one"], [2, "other"], [1000000, "many"]] },
    { "locale": "pt_BR", "cases": [[0, "one"], [1, "one"], [2, "other"], [2000000, "many"]] },
    { "locale": "pl", "cases": [[1, "one"], [2, "few"], [4, "few"], [5, "many"], [0, "many"], [12, "many"], [14, "many"], [22, "few"], [25, "many"], [101, "many"], [112, "many"], [{"num": 3, "den": 2, "dp": 1}, "other"], [{"num": 1, "den": 1, "dp": 1}, "other"]] },
    { "locale": "ru", "cases": [[1, "one"], [21, "one"], [11, "many"], [2, "few"], [24, "few"], [12, "many"], [5, "many"], [{"num": 3, "den": 2, "dp": 1}, "other"]] },
    { "locale": "uk", "cases": [[1, "one"], [3, "few"], [7, "many"]] },
    { "locale": "cs", "cases": [[1, "one"], [3, "few"], [5, "other"], [{"num": 3, "den": 2, "dp": 1}, "many"]] },
    { "locale": "ar", "cases": [[0, "zero"], [1, "one"], [2, "two"], [3, "few"], [10, "few"], [11, "many"], [99, "many"], [100, "other"], [102, "other"], [103, "few"], [111, "many"], [{"num": 3, "den": 2, "dp": 1}, "other"], [{"num": 3, "den": 1, "dp": 1}, "few"]] },
    { "locale": "ja", "cases": [[1, "other"], [0, "other"]] },
    { "locale": "zh", "cases": [[1, "other"]] },
    { "locale": "xx", "cases": [[1, "other"]] }
  ],
  "messages": [
    { "name": "plain text", "pattern": "Hello", "expect": "Hello" },
    { "name": "empty", "pattern": "", "expect": "" },
    { "name": "a string placeholder", "pattern": "Hello {$name}!", "args": {"name": "Ann"}, "expect": "Hello Ann!" },
    { "name": "spaces inside a placeholder", "pattern": "Hello { $name  }!", "args": {"name": "Ann"}, "expect": "Hello Ann!" },
    { "name": "a number placeholder", "pattern": "{$n :number} items", "args": {"n": 1234}, "expect": "1234 items" },
    { "name": "a decimal shows its places", "pattern": "{$n :number}", "args": {"n": {"num": 3, "den": 2, "dp": 2}}, "expect": "1.50" },
    { "name": "a decimal rounds half to even", "pattern": "{$n}", "args": {"n": {"num": 5, "den": 4, "dp": 1}}, "expect": "1.2" },
    { "name": "a bare number placeholder formats as a number", "pattern": "{$n}", "args": {"n": -7}, "expect": "-7" },
    { "name": "a string function shows a number's text", "pattern": "{$n :string}", "args": {"n": 5}, "expect": "5" },
    { "name": "escapes", "pattern": "a \\{b\\} c \\\\ \\|", "expect": "a {b} c \\ |" },
    { "name": "a quoted pattern", "pattern": "  {{Hello}}  ", "expect": "Hello" },
    { "name": "an input before a quoted pattern", "pattern": ".input {$x :string} {{v={$x}}}", "args": {"x": "1"}, "expect": "v=1" },
    { "name": "spec 5 example, one", "pattern": ".input {$n :number} .match $n one {{{$n} sample}} * {{{$n} samples}}", "args": {"n": 1}, "expect": "1 sample" },
    { "name": "spec 5 example, other", "pattern": ".input {$n :number} .match $n one {{{$n} sample}} * {{{$n} samples}}", "args": {"n": 3}, "expect": "3 samples" },
    { "name": "spec 5 example in Polish catalogue form, one", "locale": "pl", "pattern": ".input {$n :number} .match $n one {{{$n} próbka}} few {{{$n} próbki}} many {{{$n} próbek}} * {{{$n} próbki}}", "args": {"n": 1}, "expect": "1 próbka" },
    { "name": "Polish few", "locale": "pl", "pattern": ".input {$n :number} .match $n one {{{$n} próbka}} few {{{$n} próbki}} many {{{$n} próbek}} * {{{$n} próbki}}", "args": {"n": 22}, "expect": "22 próbki" },
    { "name": "Polish many", "locale": "pl", "pattern": ".input {$n :number} .match $n one {{{$n} próbka}} few {{{$n} próbki}} many {{{$n} próbek}} * {{{$n} próbki}}", "args": {"n": 12}, "expect": "12 próbek" },
    { "name": "Polish fraction", "locale": "pl", "pattern": ".input {$n :number} .match $n one {{{$n} próbka}} few {{{$n} próbki}} many {{{$n} próbek}} * {{{$n} próbki}}", "args": {"n": {"num": 3, "den": 2, "dp": 1}}, "expect": "1.5 próbki" },
    { "name": "Arabic zero", "locale": "ar", "pattern": ".input {$n :number} .match $n zero {{z}} one {{o}} two {{t}} few {{f}} many {{m}} * {{x}}", "args": {"n": 0}, "expect": "z" },
    { "name": "Arabic two", "locale": "ar", "pattern": ".input {$n :number} .match $n zero {{z}} one {{o}} two {{t}} few {{f}} many {{m}} * {{x}}", "args": {"n": 2}, "expect": "t" },
    { "name": "Arabic few", "locale": "ar", "pattern": ".input {$n :number} .match $n zero {{z}} one {{o}} two {{t}} few {{f}} many {{m}} * {{x}}", "args": {"n": 5}, "expect": "f" },
    { "name": "Arabic many", "locale": "ar", "pattern": ".input {$n :number} .match $n zero {{z}} one {{o}} two {{t}} few {{f}} many {{m}} * {{x}}", "args": {"n": 11}, "expect": "m" },
    { "name": "Arabic other", "locale": "ar", "pattern": ".input {$n :number} .match $n zero {{z}} one {{o}} two {{t}} few {{f}} many {{m}} * {{x}}", "args": {"n": 100}, "expect": "x" },
    { "name": "=0 is an exact key", "pattern": ".input {$n :number} .match $n =0 {{none}} one {{one}} * {{{$n}}}", "args": {"n": 0}, "expect": "none" },
    { "name": "0 is an exact key", "pattern": ".input {$n :number} .match $n 0 {{none}} * {{{$n}}}", "args": {"n": 0}, "expect": "none" },
    { "name": "an exact key compares by value", "pattern": ".input {$n :number} .match $n 1 {{exact}} * {{other}}", "args": {"n": {"num": 1, "den": 1, "dp": 2}}, "expect": "exact" },
    { "name": "a fractional exact key", "pattern": ".input {$n :number} .match $n =1.5 {{exact}} * {{other}}", "args": {"n": {"num": 3, "den": 2, "dp": 1}}, "expect": "exact" },
    { "name": "a negative exact key", "pattern": ".input {$n :number} .match $n -1 {{minus}} * {{other}}", "args": {"n": -1}, "expect": "minus" },
    { "name": "an exact key beats a category", "pattern": ".input {$n :number} .match $n one {{category}} 1 {{exact}} * {{other}}", "args": {"n": 1}, "expect": "exact" },
    { "name": "an exact key that does not match", "pattern": ".input {$n :number} .match $n 2 {{two}} * {{other}}", "args": {"n": 1}, "expect": "other" },
    { "name": "a malformed number key never matches", "pattern": ".input {$n :number} .match $n 1. {{a}} 1.2.3 {{b}} -x {{c}} 1234567890123456789 {{d}} * {{other}}", "args": {"n": 1}, "expect": "other" },
    { "name": "a string selection", "pattern": ".input {$g :string} .match $g female {{she}} male {{he}} * {{they}}", "args": {"g": "male"}, "expect": "he" },
    { "name": "a string selection falls back", "pattern": ".input {$g :string} .match $g female {{she}} * {{they}}", "args": {"g": "other"}, "expect": "they" },
    { "name": "a string selector on a number does not match", "pattern": ".input {$g :string} .match $g 1 {{one}} * {{they}}", "args": {"g": 1}, "expect": "they" },
    { "name": "a number selector on a string does not match", "pattern": ".input {$n :number} .match $n one {{one}} * {{other}}", "args": {"n": "1"}, "expect": "other" },
    { "name": "a quoted key", "pattern": ".input {$g :string} .match $g |a b| {{ab}} |c\\|d| {{cd}} * {{x}}", "args": {"g": "c|d"}, "expect": "cd" },
    { "name": "two selectors", "pattern": ".input {$a :string} .input {$n :number} .match $a $n x one {{x1}} x * {{x*}} * one {{*1}} * * {{**}}", "args": {"a": "y", "n": 1}, "expect": "*1" },
    { "name": "two selectors, first wins", "pattern": ".input {$a :string} .input {$n :number} .match $a $n * one {{*1}} x * {{x*}} * * {{**}}", "args": {"a": "x", "n": 1}, "expect": "x*" },
    { "name": "a missing argument shows its name", "pattern": "Hi {$name}", "expect": "Hi {$name}", "errors": 1 },
    { "name": "a null argument shows its name", "pattern": "Hi {$name}", "args": {"name": null}, "expect": "Hi {$name}", "errors": 1 },
    { "name": "a number function over text shows its name", "pattern": "{$n :number}", "args": {"n": "x"}, "expect": "{$n}", "errors": 1 },
    { "name": "a record argument shows its name", "pattern": "{$n}", "args": {"n": {"a": 1}}, "expect": "{$n}", "errors": 1 },
    { "name": "whitespace between the parts of a complex message", "pattern": ".input {$n :number}\n.match $n\r\n\tone {{a}} * {{b}}", "args": {"n": 1}, "expect": "a" },
    { "name": "a variable with capitals and an underscore", "pattern": "{$My_name}", "args": {"My_name": "x"}, "expect": "x" },
    { "name": "a variant after the catch-all", "pattern": ".input {$n :number} .match $n * {{other}} one {{one}}", "args": {"n": 1}, "expect": "one" },
    { "name": "keys that look like numbers and are not", "pattern": ".input {$n :number} .match $n .5 {{a}} - {{b}} * {{other}}", "args": {"n": 1}, "expect": "other" },
    { "name": "a placeholder's own function wins over its declaration", "pattern": ".input {$n :number} {{{$n :string}}}", "args": {"n": 5}, "expect": "5" },
    { "name": "an input no placeholder uses", "pattern": ".input {$a :number} {{{$b}}}", "args": {"b": "x"}, "expect": "x" },
    { "name": "a missing selector selects the catch-all", "pattern": ".input {$n :number} .match $n one {{one}} * {{other {$n}}}", "expect": "other {$n}", "errors": 1 },

    { "name": "a literal placeholder is outside the subset", "pattern": "{0} outside limits", "refused": "only variable placeholders" },
    { "name": "a quoted literal placeholder", "pattern": "{|x|}", "refused": "only variable placeholders" },
    { "name": "options", "pattern": "{$n :number minimumFractionDigits=2}", "refused": "options" },
    { "name": "another function", "pattern": "{$n :date}", "refused": ":date" },
    { "name": "a local declaration", "pattern": ".local $x = {$y} {{a}}", "refused": ".input" },
    { "name": "a selector without input", "pattern": ".match $n * {{a}}", "refused": "needs an `.input`" },
    { "name": "a selector whose input has no function", "pattern": ".input {$n} .match $n * {{a}}", "refused": "needs an `.input`" },
    { "name": "no catch-all", "pattern": ".input {$n :number} .match $n one {{a}}", "refused": "catch-all" },
    { "name": "too many keys", "pattern": ".input {$n :number} .match $n one two {{a}} * {{b}}", "refused": "one key per selector" },
    { "name": "no selector", "pattern": ".input {$n :number} .match {{a}}", "refused": "at least one selector" },
    { "name": "an unescaped closing brace", "pattern": "a } b", "refused": "unescaped" },
    { "name": "an unclosed placeholder", "pattern": "{$n", "refused": "options and attributes" },
    { "name": "a placeholder at the end", "pattern": "a {", "refused": "not closed" },
    { "name": "an unclosed quoted pattern", "pattern": "{{abc", "refused": "not closed with `}}`" },
    { "name": "a bad escape", "pattern": "\\x", "refused": "escapes only" },
    { "name": "a trailing backslash", "pattern": "a\\", "refused": "escapes only" },
    { "name": "text after a quoted pattern", "pattern": "{{a}} b", "refused": "after the quoted pattern" },
    { "name": "an input without braces", "pattern": ".input $n {{a}}", "refused": "takes a" },
    { "name": "an input with a bad body", "pattern": ".input {x} {{a}}", "refused": "only variable placeholders" },
    { "name": "an empty variable", "pattern": "{$}", "refused": "needs a name" },
    { "name": "a bad selector", "pattern": ".input {$n :number} .match $ * {{a}}", "refused": "needs a name" },
    { "name": "an unclosed quoted key", "pattern": ".input {$n :number} .match $n |a {{x}}", "refused": "not closed with `|`" },
    { "name": "a variant without a pattern", "pattern": ".input {$n :number} .match $n one", "refused": "quoted pattern" },
    { "name": "a bad key", "pattern": ".input {$n :number} .match $n ?? {{a}} * {{b}}", "refused": "variant key is expected" },
    { "name": "a bad pattern in a variant", "pattern": ".input {$n :number} .match $n one {{a}b}} * {{b}}", "refused": "unescaped" },
    { "name": "a bad quoted body", "pattern": ".input {$n :number} {{a {$}}}", "refused": "needs a name" },
    { "name": "a bad input body", "pattern": ".input {$n :foo} {{a}}", "refused": ":foo" },
    { "name": "a quoted key ending in an escape", "pattern": ".input {$g :string} .match $g |a\\", "refused": "not closed with `|`" },
    { "name": "an input at the end", "pattern": ".input", "refused": "`.input` takes" },
    { "name": "a match with no variants", "pattern": ".input {$n :number} .match $n", "refused": "catch-all" },
    { "name": "a complex message without a body", "pattern": ".input {$n :number}", "refused": "only `.input`" }
  ]
}
