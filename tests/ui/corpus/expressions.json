{
  "units": {
    "mg": { "canonical": "g", "num": 1, "den": 1000 },
    "kg": { "canonical": "g", "num": 1000, "den": 1 },
    "ug": { "canonical": "g", "num": 1, "den": 1000000, "display": "µg" },
    "cm": { "canonical": "m", "num": 1, "den": 100 }
  },
  "evaluate": [
    { "name": "an integer literal", "expr": 5, "expect": 5 },
    { "name": "a string literal", "expr": "x", "expect": "x" },
    { "name": "a bool literal", "expr": true, "expect": true },
    { "name": "null", "expr": null, "expect": null },
    { "name": "a decimal literal", "expr": { "lit": { "num": 1, "den": 2, "dp": 1 } }, "expect": { "num": 1, "den": 2, "dp": 1 } },
    { "name": "a list literal", "expr": { "lit": [1, "a"] }, "expect": [1, "a"] },
    { "name": "a record literal", "expr": { "lit": { "a": 1 } }, "expect": { "a": 1 } },

    { "name": "ref", "expr": { "ref": "a" }, "env": { "names": { "a": 1 } }, "expect": 1 },
    { "name": "ref with a path", "expr": { "ref": "rec.x.y" }, "env": { "names": { "rec": { "x": { "y": 3 } } } }, "expect": 3 },
    { "name": "ref to a missing name", "expr": { "ref": "missing" }, "expect": null },
    { "name": "ref into a list by index", "expr": { "ref": "items.1" }, "env": { "names": { "items": [10, 20] } }, "expect": 20 },
    { "name": "ref into a list by a name", "expr": { "ref": "items.x" }, "env": { "names": { "items": [10, 20] } }, "expect": null },
    { "name": "ref past a list's end", "expr": { "ref": "items.5" }, "env": { "names": { "items": [10, 20] } }, "expect": null },
    { "name": "ref to a missing field", "expr": { "ref": "rec.nofield" }, "env": { "names": { "rec": { "a": 1 } } }, "expect": null },
    { "name": "ref through a scalar", "expr": { "ref": "a.b" }, "env": { "names": { "a": 1 } }, "expect": null },
    { "name": "row field", "expr": { "row": "id" }, "env": { "row": { "id": 7 } }, "expect": 7 },
    { "name": "the whole row", "expr": { "row": "" }, "env": { "row": { "id": 7 } }, "expect": { "id": 7 } },
    { "name": "query", "expr": { "query": "q" }, "env": { "queries": { "q": [1] } }, "expect": [1] },
    { "name": "pending", "expr": { "pending": "q" }, "env": { "pending": ["q"] }, "expect": true },
    { "name": "not pending", "expr": { "pending": "r" }, "env": { "pending": ["q"] }, "expect": false },
    { "name": "error", "expr": { "error": "q" }, "env": { "errors": { "q": "boom" } }, "expect": "boom" },
    { "name": "result", "expr": { "result": "m" }, "env": { "results": { "m": { "id": 4 } } }, "expect": { "id": 4 } },
    { "name": "errorKind", "expr": { "errorKind": "m" }, "env": { "errorKinds": { "m": "denied" } }, "expect": "denied" },
    { "name": "can", "expr": { "can": "m" }, "env": { "permitted": ["m"] }, "expect": true },
    { "name": "can a host command the client lacks", "expr": { "can": "host:openPath" }, "expect": false },
    { "name": "can a host command the client has", "expr": { "can": "host:openPath" }, "env": { "permitted": ["host:openPath"] }, "expect": true },
    { "name": "pref", "expr": { "pref": "density" }, "env": { "prefs": { "density": "compact" } }, "expect": "compact" },
    { "name": "pref with a path", "expr": { "pref": "cols.0" }, "env": { "prefs": { "cols": ["a", "b"] } }, "expect": "a" },
    { "name": "env", "expr": { "env": "widthClass" }, "env": { "environment": { "widthClass": "compact" } }, "expect": "compact" },
    { "name": "env online", "expr": { "env": "online" }, "env": { "environment": { "online": false } }, "expect": false },
    { "name": "session", "expr": { "session": "displayName" }, "env": { "session": { "displayName": "Ann" } }, "expect": "Ann" },
    { "name": "host value", "expr": { "host": "sync.count" }, "env": { "host": { "sync.count": 3 } }, "expect": 3 },
    { "name": "a host value the client lacks", "expr": { "host": "sync.count" }, "expect": null },

    { "name": "if true", "expr": { "if": [true, 1, 2] }, "expect": 1 },
    { "name": "if false", "expr": { "if": [false, 1, 2] }, "expect": 2 },
    { "name": "if null", "expr": { "if": [null, 1, 2] }, "expect": null },
    { "name": "if over a non-bool", "expr": { "if": [5, 1, 2] }, "expect": null, "reports": 1 },
    { "name": "obj", "expr": { "obj": { "a": { "ref": "x" }, "b": 2 } }, "env": { "names": { "x": "v" } }, "expect": { "a": "v", "b": 2 } },
    { "name": "list", "expr": { "list": [1, { "ref": "x" }] }, "env": { "names": { "x": "v" } }, "expect": [1, "v"] },

    { "name": "map", "expr": { "map": { "lit": [1, 2, 3] }, "as": "x", "to": { "fn": "mul", "args": [{ "ref": "x" }, 2] } }, "expect": [2, 4, 6] },
    { "name": "filter", "expr": { "filter": { "lit": [1, 2, 3] }, "as": "x", "where": { "fn": "gt", "args": [{ "ref": "x" }, 1] } }, "expect": [2, 3] },
    { "name": "filter drops a null condition", "expr": { "filter": { "lit": [1, null] }, "as": "x", "where": { "fn": "gt", "args": [{ "ref": "x" }, 0] } }, "expect": [1] },
    { "name": "map over null", "expr": { "map": { "ref": "none" }, "as": "x", "to": 1 }, "expect": null },
    { "name": "map over a non-list", "expr": { "map": 5, "as": "x", "to": 1 }, "expect": null, "reports": 1 },
    { "name": "filter with a non-bool condition", "expr": { "filter": { "lit": [1] }, "as": "x", "where": 5 }, "expect": null, "reports": 1 },
    { "name": "a comprehension variable with a path", "expr": { "map": { "lit": [{ "a": 1 }, { "a": 2 }] }, "as": "r", "to": { "ref": "r.a" } }, "expect": [1, 2] },
    { "name": "a comprehension variable shadows a name", "expr": { "map": { "lit": [1] }, "as": "x", "to": { "ref": "x" } }, "env": { "names": { "x": 100 } }, "expect": [1] },
    { "name": "nested comprehensions", "expr": { "map": { "lit": [1, 2] }, "as": "x", "to": { "map": { "lit": [10] }, "as": "y", "to": { "fn": "add", "args": [{ "ref": "x" }, { "ref": "y" }] } } }, "expect": [[11], [12]] },

    { "name": "and true true", "expr": { "fn": "and", "args": [true, true] }, "expect": true },
    { "name": "and true false", "expr": { "fn": "and", "args": [true, false] }, "expect": false },
    { "name": "and true null", "expr": { "fn": "and", "args": [true, null] }, "expect": null },
    { "name": "and false null", "expr": { "fn": "and", "args": [false, null] }, "expect": false },
    { "name": "and null false", "expr": { "fn": "and", "args": [null, false] }, "expect": false },
    { "name": "and null null", "expr": { "fn": "and", "args": [null, null] }, "expect": null },
    { "name": "and of one", "expr": { "fn": "and", "args": [true] }, "expect": true },
    { "name": "and over a non-bool", "expr": { "fn": "and", "args": [5, true] }, "expect": null, "reports": 1 },
    { "name": "and: false dominates a non-bool", "expr": { "fn": "and", "args": [5, false] }, "expect": false, "reports": 1 },
    { "name": "or false false", "expr": { "fn": "or", "args": [false, false] }, "expect": false },
    { "name": "or false true", "expr": { "fn": "or", "args": [false, true] }, "expect": true },
    { "name": "or null true", "expr": { "fn": "or", "args": [null, true] }, "expect": true },
    { "name": "or false null", "expr": { "fn": "or", "args": [false, null] }, "expect": null },
    { "name": "not true", "expr": { "fn": "not", "args": [true] }, "expect": false },
    { "name": "not null", "expr": { "fn": "not", "args": [null] }, "expect": null },
    { "name": "not over a non-bool", "expr": { "fn": "not", "args": [5] }, "expect": null, "reports": 1 },

    { "name": "eq int and decimal", "expr": { "fn": "eq", "args": [1, { "lit": { "num": 1, "den": 1, "dp": 2 } }] }, "expect": true },
    { "name": "eq strings", "expr": { "fn": "eq", "args": ["a", "a"] }, "expect": true },
    { "name": "eq different strings", "expr": { "fn": "eq", "args": ["a", "b"] }, "expect": false },
    { "name": "eq across kinds", "expr": { "fn": "eq", "args": [1, "1"] }, "expect": false },
    { "name": "eq with null", "expr": { "fn": "eq", "args": [null, 1] }, "expect": null },
    { "name": "ne", "expr": { "fn": "ne", "args": [1, 2] }, "expect": true },
    { "name": "eq lists", "expr": { "fn": "eq", "args": [{ "lit": [1, null] }, { "lit": [1, null] }] }, "expect": true },
    { "name": "eq lists of different length", "expr": { "fn": "eq", "args": [{ "lit": [1, 2] }, { "lit": [1] }] }, "expect": false },
    { "name": "eq lists with a null against a value", "expr": { "fn": "eq", "args": [{ "lit": [1, null] }, { "lit": [1, 2] }] }, "expect": false },
    { "name": "eq lists with a different element", "expr": { "fn": "eq", "args": [{ "lit": [1, 2] }, { "lit": [1, 3] }] }, "expect": false },
    { "name": "eq records", "expr": { "fn": "eq", "args": [{ "lit": { "a": 1, "b": null } }, { "lit": { "a": 1, "b": null } }] }, "expect": true },
    { "name": "eq records with a different key", "expr": { "fn": "eq", "args": [{ "lit": { "a": 1 } }, { "lit": { "b": 1 } }] }, "expect": false },
    { "name": "eq records of different size", "expr": { "fn": "eq", "args": [{ "lit": { "a": 1 } }, { "lit": { "a": 1, "b": 2 } }] }, "expect": false },
    { "name": "eq records with a null against a value", "expr": { "fn": "eq", "args": [{ "lit": { "a": null } }, { "lit": { "a": 1 } }] }, "expect": false },
    { "name": "eq records with a different value", "expr": { "fn": "eq", "args": [{ "lit": { "a": 1 } }, { "lit": { "a": 2 } }] }, "expect": false },
    { "name": "eq bools", "expr": { "fn": "eq", "args": [true, true] }, "expect": true },
    { "name": "eq quantities across units", "expr": { "fn": "eq", "args": [{ "lit": { "num": 1000, "den": 1, "dp": 0, "unit": "mg" } }, { "lit": { "num": 1, "den": 1, "dp": 0, "unit": "g" } }] }, "expect": true },
    { "name": "eq quantities of different dimensions", "expr": { "fn": "eq", "args": [{ "lit": { "num": 1, "den": 1, "dp": 0, "unit": "g" } }, { "lit": { "num": 1, "den": 1, "dp": 0, "unit": "m" } }] }, "expect": false },
    { "name": "eq a quantity and a number", "expr": { "fn": "eq", "args": [{ "lit": { "num": 1, "den": 1, "dp": 0, "unit": "g" } }, 1] }, "expect": false },
    { "name": "eq timestamps", "expr": { "fn": "eq", "args": [{ "ref": "t1" }, { "ref": "t1" }] }, "env": { "timestamps": { "t1": "2026-10-11T08:30:00Z" } }, "expect": true },
    { "name": "lt", "expr": { "fn": "lt", "args": [1, 2] }, "expect": true },
    { "name": "le equal", "expr": { "fn": "le", "args": [2, 2] }, "expect": true },
    { "name": "gt", "expr": { "fn": "gt", "args": [3, 2] }, "expect": true },
    { "name": "ge false", "expr": { "fn": "ge", "args": [1, 2] }, "expect": false },
    { "name": "lt decimal and int", "expr": { "fn": "lt", "args": [{ "lit": { "num": 3, "den": 2, "dp": 1 } }, 2] }, "expect": true },
    { "name": "lt strings", "expr": { "fn": "lt", "args": ["a", "b"] }, "expect": true },
    { "name": "lt across kinds", "expr": { "fn": "lt", "args": [1, "a"] }, "expect": null, "reports": 1 },
    { "name": "lt a string and a number", "expr": { "fn": "lt", "args": ["a", 1] }, "expect": null, "reports": 1 },
    { "name": "lt quantities across units", "expr": { "fn": "lt", "args": [{ "lit": { "num": 500, "den": 1, "dp": 0, "unit": "mg" } }, { "lit": { "num": 1, "den": 1, "dp": 0, "unit": "g" } }] }, "expect": true },
    { "name": "lt quantities of different dimensions", "expr": { "fn": "lt", "args": [{ "lit": { "num": 1, "den": 1, "dp": 0, "unit": "g" } }, { "lit": { "num": 1, "den": 1, "dp": 0, "unit": "m" } }] }, "expect": null, "reports": 1 },
    { "name": "lt a quantity and a number", "expr": { "fn": "lt", "args": [{ "lit": { "num": 1, "den": 1, "dp": 0, "unit": "g" } }, 1] }, "expect": null, "reports": 1 },
    { "name": "lt timestamps", "expr": { "fn": "lt", "args": [{ "ref": "t1" }, { "ref": "t2" }] }, "env": { "timestamps": { "t1": "2026-10-11T08:30:00Z", "t2": "2026-10-12T08:30:00Z" } }, "expect": true },
    { "name": "lt a timestamp and a string", "expr": { "fn": "lt", "args": [{ "ref": "t1" }, "x"] }, "env": { "timestamps": { "t1": "2026-10-11T08:30:00Z" } }, "expect": null, "reports": 1 },
    { "name": "lt with null", "expr": { "fn": "lt", "args": [null, 1] }, "expect": null },

    { "name": "add ints", "expr": { "fn": "add", "args": [1, 2] }, "expect": 3 },
    { "name": "add int and decimal", "expr": { "fn": "add", "args": [1, { "lit": { "num": 3, "den": 2, "dp": 1 } }] }, "expect": { "num": 5, "den": 2, "dp": 1 } },
    { "name": "sub", "expr": { "fn": "sub", "args": [5, 7] }, "expect": -2 },
    { "name": "mul", "expr": { "fn": "mul", "args": [3, 4] }, "expect": 12 },
    { "name": "mul a decimal keeps its places", "expr": { "fn": "mul", "args": [{ "lit": { "num": 3, "den": 2, "dp": 1 } }, 2] }, "expect": { "num": 3, "den": 1, "dp": 1 } },
    { "name": "div is exact", "expr": { "fn": "div", "args": [7, 2] }, "expect": { "num": 7, "den": 2, "dp": 0 } },
    { "name": "div of ints that divide", "expr": { "fn": "div", "args": [6, 3] }, "expect": 2 },
    { "name": "div by zero", "expr": { "fn": "div", "args": [1, 0] }, "expect": null, "reports": 1 },
    { "name": "div by a zero decimal", "expr": { "fn": "div", "args": [{ "lit": { "num": 1, "den": 1, "dp": 1 } }, { "lit": { "num": 0, "den": 1, "dp": 1 } }] }, "expect": null, "reports": 1 },
    { "name": "add overflows", "expr": { "fn": "add", "args": [9223372036854775807, 1] }, "expect": null, "reports": 1 },
    { "name": "sub overflows", "expr": { "fn": "sub", "args": [-9223372036854775807, 2] }, "expect": null, "reports": 1 },
    { "name": "mul overflows", "expr": { "fn": "mul", "args": [4611686018427387904, 4] }, "expect": null, "reports": 1 },
    { "name": "add with null", "expr": { "fn": "add", "args": [null, 1] }, "expect": null },
    { "name": "add a string", "expr": { "fn": "add", "args": ["a", 1] }, "expect": null, "reports": 1 },
    { "name": "add quantities across units", "expr": { "fn": "add", "args": [{ "lit": { "num": 1, "den": 1, "dp": 0, "unit": "g" } }, { "lit": { "num": 500, "den": 1, "dp": 0, "unit": "mg" } }] }, "expect": { "num": 3, "den": 2, "dp": 3, "unit": "g" } },
    { "name": "sub quantities across units", "expr": { "fn": "sub", "args": [{ "lit": { "num": 1, "den": 1, "dp": 0, "unit": "kg" } }, { "lit": { "num": 1, "den": 1, "dp": 0, "unit": "g" } }] }, "expect": { "num": 999, "den": 1000, "dp": 3, "unit": "kg" } },
    { "name": "add quantities of different dimensions", "expr": { "fn": "add", "args": [{ "lit": { "num": 1, "den": 1, "dp": 0, "unit": "g" } }, { "lit": { "num": 1, "den": 1, "dp": 0, "unit": "m" } }] }, "expect": null, "reports": 1 },
    { "name": "add a quantity and a number", "expr": { "fn": "add", "args": [{ "lit": { "num": 1, "den": 1, "dp": 0, "unit": "g" } }, 1] }, "expect": null, "reports": 1 },
    { "name": "mul a quantity by a number", "expr": { "fn": "mul", "args": [{ "lit": { "num": 2, "den": 1, "dp": 0, "unit": "g" } }, 3] }, "expect": { "num": 6, "den": 1, "dp": 0, "unit": "g" } },
    { "name": "mul a number by a quantity", "expr": { "fn": "mul", "args": [3, { "lit": { "num": 2, "den": 1, "dp": 0, "unit": "g" } }] }, "expect": { "num": 6, "den": 1, "dp": 0, "unit": "g" } },
    { "name": "mul two quantities", "expr": { "fn": "mul", "args": [{ "lit": { "num": 2, "den": 1, "dp": 0, "unit": "g" } }, { "lit": { "num": 2, "den": 1, "dp": 0, "unit": "g" } }] }, "expect": null, "reports": 1 },
    { "name": "div a quantity by a number", "expr": { "fn": "div", "args": [{ "lit": { "num": 6, "den": 1, "dp": 0, "unit": "g" } }, 3] }, "expect": { "num": 2, "den": 1, "dp": 0, "unit": "g" } },
    { "name": "div a number by a quantity", "expr": { "fn": "div", "args": [3, { "lit": { "num": 1, "den": 1, "dp": 0, "unit": "g" } }] }, "expect": null, "reports": 1 },
    { "name": "div two quantities is a ratio", "expr": { "fn": "div", "args": [{ "lit": { "num": 1, "den": 1, "dp": 0, "unit": "g" } }, { "lit": { "num": 500, "den": 1, "dp": 0, "unit": "mg" } }] }, "expect": { "num": 2, "den": 1, "dp": 3 } },
    { "name": "div by a zero quantity", "expr": { "fn": "div", "args": [{ "lit": { "num": 1, "den": 1, "dp": 0, "unit": "g" } }, { "lit": { "num": 0, "den": 1, "dp": 0, "unit": "mg" } }] }, "expect": null, "reports": 1 },
    { "name": "a conversion with a non-decimal ratio", "expr": { "fn": "add", "args": [{ "lit": { "num": 1, "den": 1, "dp": 0, "unit": "whole" } }, { "lit": { "num": 1, "den": 1, "dp": 0, "unit": "third" } }] }, "env": { "units": { "third": { "canonical": "whole", "num": 1, "den": 3 } } }, "expect": { "num": 4, "den": 3, "dp": 0, "unit": "whole" } },
    { "name": "neg", "expr": { "fn": "neg", "args": [5] }, "expect": -5 },
    { "name": "neg a decimal", "expr": { "fn": "neg", "args": [{ "lit": { "num": 3, "den": 2, "dp": 1 } }] }, "expect": { "num": -3, "den": 2, "dp": 1 } },
    { "name": "neg a quantity", "expr": { "fn": "neg", "args": [{ "lit": { "num": 2, "den": 1, "dp": 0, "unit": "g" } }] }, "expect": { "num": -2, "den": 1, "dp": 0, "unit": "g" } },
    { "name": "neg overflows", "expr": { "fn": "neg", "args": [-9223372036854775808] }, "expect": null, "reports": 1 },
    { "name": "neg a string", "expr": { "fn": "neg", "args": ["x"] }, "expect": null, "reports": 1 },
    { "name": "round half to even down", "expr": { "fn": "round", "args": [{ "lit": { "num": 125, "den": 100, "dp": 2 } }, 1] }, "expect": { "num": 6, "den": 5, "dp": 1 } },
    { "name": "round half to even up", "expr": { "fn": "round", "args": [{ "lit": { "num": 135, "den": 100, "dp": 2 } }, 1] }, "expect": { "num": 7, "den": 5, "dp": 1 } },
    { "name": "round an int", "expr": { "fn": "round", "args": [5, 2] }, "expect": 5 },
    { "name": "round a quantity", "expr": { "fn": "round", "args": [{ "lit": { "num": 3, "den": 2, "dp": 1, "unit": "g" } }, 0] }, "expect": { "num": 2, "den": 1, "dp": 0, "unit": "g" } },
    { "name": "round to too many places", "expr": { "fn": "round", "args": [{ "lit": { "num": 1, "den": 2, "dp": 1 } }, 19] }, "expect": null, "reports": 1 },
    { "name": "round to negative places", "expr": { "fn": "round", "args": [{ "lit": { "num": 1, "den": 2, "dp": 1 } }, -1] }, "expect": null, "reports": 1 },
    { "name": "round a string", "expr": { "fn": "round", "args": ["x", 1] }, "expect": null, "reports": 1 },
    { "name": "round overflows", "expr": { "fn": "round", "args": [{ "lit": { "num": 9223372036854775807, "den": 1, "dp": 0 } }, 1] }, "expect": null, "reports": 1 },

    { "name": "engaged null", "expr": { "fn": "engaged", "args": [null] }, "expect": false },
    { "name": "engaged zero", "expr": { "fn": "engaged", "args": [0] }, "expect": true },
    { "name": "coalesce", "expr": { "fn": "coalesce", "args": [null, { "ref": "none" }, 3, 4] }, "expect": 3 },
    { "name": "coalesce of nulls", "expr": { "fn": "coalesce", "args": [null] }, "expect": null },

    { "name": "concat", "expr": { "fn": "concat", "args": ["a", "b", "c"] }, "expect": "abc" },
    { "name": "concat with null", "expr": { "fn": "concat", "args": ["a", null] }, "expect": null },
    { "name": "concat a number", "expr": { "fn": "concat", "args": ["a", 1] }, "expect": null, "reports": 1 },
    { "name": "format", "expr": { "fn": "format", "args": ["{0} of {1}", 3, "x"] }, "expect": "3 of x" },
    { "name": "format escapes braces", "expr": { "fn": "format", "args": ["{{0}} }}", 1] }, "expect": "{0} }" },
    { "name": "format a decimal at its places", "expr": { "fn": "format", "args": ["{0}", { "lit": { "num": 3, "den": 2, "dp": 2 } }] }, "expect": "1.50" },
    { "name": "format a bool", "expr": { "fn": "format", "args": ["{0}/{1}", true, false] }, "expect": "true/false" },
    { "name": "format a quantity", "expr": { "fn": "format", "args": ["{0}", { "lit": { "num": 2, "den": 1, "dp": 0, "unit": "ug" } }] }, "expect": "2 µg" },
    { "name": "format a timestamp", "expr": { "fn": "format", "args": ["{0}", { "ref": "t1" }] }, "env": { "timestamps": { "t1": "2026-10-11T08:30:00Z" } }, "expect": "2026-10-11 08:30" },
    { "name": "format with a missing argument", "expr": { "fn": "format", "args": ["{1}", 1] }, "expect": null, "reports": 1 },
    { "name": "format with a malformed placeholder", "expr": { "fn": "format", "args": ["{x}", 1] }, "expect": null, "reports": 1 },
